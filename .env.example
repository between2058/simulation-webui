# ============================================
# Simulation WebUI Environment Configuration
# ============================================
# Copy this file to .env and modify as needed
# All VITE_ prefixed variables are available in the browser

# ---- Server Configuration ----
# Host address (use 0.0.0.0 for network access)
VITE_HOST=localhost
# Development server port
VITE_PORT=5173

# ---- MuJoCo Backend Configuration ----
# WebSocket URL for MuJoCo physics server (with /ws path)
VITE_MUJOCO_WS_URL=ws://localhost:8765/ws
# Default URL shown in UI (without /ws path)
VITE_MUJOCO_URL=ws://localhost:8765
# Reconnection delay in milliseconds
VITE_MUJOCO_RECONNECT_DELAY=3000

# ---- Simulation Settings ----
# Maximum number of robots (1-8)
VITE_MAX_ROBOTS=8
# Default simulation speed multiplier
VITE_DEFAULT_SPEED=1.0
# Maximum simulation speed
VITE_MAX_SPEED=3.0

# ---- Application Settings ----
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=RoboDog Simulation
